# Common configuration for all targets
# WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# mDNS priority/affinity live in the per-target defaults, because
# CONFIG_MDNS_TASK_AFFINITY_CPU1 depends on !FREERTOS_UNICORE and would be
# silently inert on a single-core target if placed here.
# Per-socket UDP receive mailbox depth. This -- not SO_RCVBUF -- is what limits
# how many RTP datagrams lwIP can queue for the RTP thread while it is between
# select()/recvfrom() iterations; overflow here is a dropped audio packet. The
# default of 6 can be exhausted by a WiFi-level burst, so raise it. Each slot is
# one small pbuf, and only the ~3 RTP sockets use a deep mailbox.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
